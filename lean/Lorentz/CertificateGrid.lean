def node (z : ℝ) (j : ℕ) : ℝ := eval (nodeCoeffs j) z
def gridPerturbation (z : ℝ) (j : ℕ) : ℝ := eval (h0Coeffs j) z + beta z * eval (h1Coeffs j) z

def correction (n : ℕ) (z x : ℝ) : ℝ := match n with
  | 0 => 0
  | 1 | 2 => v1 z * x
  | 3 => v31 z * x + v32 z * x ^ 2 + v33 z * x ^ 3
  | 4 => 8 * x ^ 4 - 8 * x ^ 2 + v41 z * x + v43 z * (4 * x ^ 3 - 3 * x)
  | 5 | 6 => 8 * x ^ 4 - 8 * x ^ 2 + v51 z * x + v53 z * (4 * x ^ 3 - 3 * x) + v55 z * (16 * x ^ 5 - 20 * x ^ 3 + 5 * x)
  | _ => 0

def slope (n : ℕ) (z : ℝ) : ℝ := match n with
  | 0 => t0 z
  | 1 | 2 => t1 z
  | 3 => t3 z
  | 4 => t4 z
  | 5 | 6 => t5 z
  | _ => 0

def fineSign (j : ℕ) : ℝ := if j % 4 = 0 ∨ j % 4 = 3 then 1 else -1
def coarseSign (j : ℕ) : ℝ := -fineSign j
def gridIndex (n j : ℕ) : ℕ := if n < 3 then 3 * j + 1 else j
def gridSign (n j : ℕ) : ℝ := if n < 3 then coarseSign j else fineSign j
def gridSize (n : ℕ) : ℕ := if n < 3 then 6 else 18
def slackCoeffs (n j : ℕ) : List ℚ := (slackRows.getD n []).getD j []

 theorem correction_zero (n : ℕ) (z : ℝ) : correction n z 0 = 0 := by
  cases n with
  | zero => rfl
  | succ n =>
    match n with
    | 0 | 1 | 2 | 3 | 4 | 5 => simp [correction]
    | _ + 6 => simp [correction]

