namespace Lorentz.Plateau.Certificates.Odd

def slackQuotient2_0 : List ℚ :=
  [(3687443 / 35664855), (4815405 / 4755314), (107514083 / 71329710), (-27099 / 2377657),
    (-27927494 / 35664855)]

theorem slack_2_0 (z : ℝ) (hm : Certificate.eval modulusCoeffs z = 0) :
    slope z 2 - (1 : ℝ) * (value z 0 -
      (correction 2 z).eval (node z 0)) =
      Certificate.eval ((slackRows.getD 2 []).getD 0 []) z := by
  simpa only [slope, value, correction, node, Rat.cast_neg, Rat.cast_one] using
    Checker.slack (correctionRows.getD 2 []) (nodeRows.getD 0 [])
      (gridValues.getD 0 []) (slopeRows.getD 2 [])
      ((slackRows.getD 2 []).getD 0 []) slackQuotient2_0 modulusCoeffs
      (1) z hm (by decide +kernel)

