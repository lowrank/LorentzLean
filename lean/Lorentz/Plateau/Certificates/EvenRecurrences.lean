theorem recurrence_34 (z : ℝ) (hm : Certificate.eval modulusCoeffs z = 0) :
    value z 34 = (forcing z).eval (node z 34) + (-3 / 5 : ℝ) * value z 31 := by
  simpa only [value, forcing, node, Rat.cast_div, Rat.cast_neg, Rat.cast_ofNat] using
