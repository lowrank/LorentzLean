Lorentz.Construction.lorentz_counterexample :
  ∃ f,
    ContinuousOn f Lorentz.interval ∧
      f 0 = 0 ∧
        (∃ x ∈ Lorentz.interval, f (-x) ≠ -f x) ∧
          ∀ (n : ℕ), (∃ p, Lorentz.IsBest f n p) ∧ ∀ (p : Polynomial ℝ), Lorentz.IsBest f n p → Polynomial.eval 0 p = 0
'Lorentz.Construction.lorentz_counterexample' depends on axioms: [propext, Classical.choice, Quot.sound]
